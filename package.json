{
  "name": "contextseal",
  "version": "0.1.0",
  "description": "Graph-backed certification for high-risk data changes",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyganali-glitch/ContextSeal.git"
  },
  "homepage": "https://zyganali-glitch.github.io/ContextSeal/",
  "bugs": {
    "url": "https://github.com/zyganali-glitch/ContextSeal/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "demo": "npm run demo:generate",
    "demo:generate": "node scripts/run-demo.js",
    "demo:check": "node scripts/run-demo.js --check",
    "sandbox": "npm run sandbox:generate",
    "sandbox:generate": "python scripts/run-generated-sandbox.py --evidence-output examples/outputs/sandbox/generated-sandbox-evidence.json",
    "sandbox:check": "python scripts/run-generated-sandbox.py --check --evidence-output examples/outputs/sandbox/generated-sandbox-evidence.json",
    "dbt:proof": "node scripts/run-dbt-proof.js",
    "dbt:proof:check": "node scripts/check-dbt-proof.js",
    "pr:bundle": "node scripts/build-pr-bundle.js",
    "pr:bundle:check": "node scripts/build-pr-bundle.js --check",
    "pr:draft": "node scripts/create-draft-pr.js",
    "ai:probe": "node scripts/probe-ai-runtime.js",
    "ai:capture": "node scripts/capture-ai-proof.js",
    "ai:proof": "node scripts/check-ai-proof.js",
    "datahub:seed": "node scripts/run-datahub-seed.js",
    "datahub:seed:preflight": "uv run --with acryl-datahub==1.6.0.14 python scripts/seed-datahub.py --preflight",
    "datahub:seed:apply": "uv run --with acryl-datahub==1.6.0.14 python scripts/seed-datahub.py --apply",
    "datahub:seed:scope": "uv run --with acryl-datahub==1.6.0.14 python scripts/seed-datahub.py --print-scope",
    "datahub:properties": "uv run --with acryl-datahub==1.6.0.14 python scripts/upsert-datahub-properties.py --preflight",
    "datahub:properties:apply": "uv run --with acryl-datahub==1.6.0.14 python scripts/upsert-datahub-properties.py --apply",
    "datahub:properties:scope": "uv run --with acryl-datahub==1.6.0.14 python scripts/upsert-datahub-properties.py --print-scope",
    "datahub:safety:test": "python -m unittest discover -s tests_py -p test_*.py",
    "datahub:capture": "node scripts/capture-live-evidence.js",
    "datahub:prove": "node scripts/run-live-proof.js",
    "datahub:export": "node scripts/export-live-run.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "plan:check": "node scripts/check-plan-integrity.js",
    "prevideo:check": "npm run check && npm run ai:proof && npm run dbt:proof:check",
    "submission:check": "npm run validate && git diff --exit-code",
    "check": "npm run plan:check && node scripts/check-repository.js",
    "evidence:check": "node scripts/validate-evidence.js",
    "smoke": "node scripts/smoke-server.js",
    "validate": "npm run prevideo:check && npm run datahub:safety:test && npm test && npm run demo:check && npm run sandbox:check && npm run smoke && npm run pr:bundle:check && npm run pr:draft -- --dry-run"
  },
  "keywords": [
    "datahub",
    "mcp",
    "data-lineage",
    "data-governance",
    "ai-agents",
    "dbt"
  ],
  "license": "Apache-2.0"
}
